{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Mingo Docs",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get Started",
            "pages": ["index", "quickstart", "development"]
          },
          {
            "group": "Authentication",
            "pages": ["authentication/introduction"]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "API Documentation",
            "pages": ["api-reference/introduction"]
          },
          {
            "group": "Endpoint Examples",
            "pages": ["api-reference/endpoint/get", "api-reference/endpoint/create", "api-reference/endpoint/delete", "api-reference/endpoint/webhook"]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "href": "https://mintlify.com/docs",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Community",
          "href": "https://mintlify.com/community",
          "icon": "slack"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/mingo.png",
    "dark": "/logo/mingo.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@mingo.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get the Mingo App",
      "href": "https://web.mingo.com/install"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/mingoapps"
    }
  }
}
